# Example environment variables for JobHub-AI
# Copy to `.env` in development and set real secrets.

# Server settings
NODE_ENV=development
PORT=5000

# Frontend client URL (used in CORS)
CLIENT_URL=http://localhost:3000

# OpenAI API key (optional - leave blank to use heuristic fallback)
OPENAI_API_KEY=

# Optional API key to protect mutating endpoints (set to enable API key enforcement)
API_KEY=

# Vercel CI/CD: Vercel will manage VERCEL and VERCEL_ENV
# VERCEL=1
